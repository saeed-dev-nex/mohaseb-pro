{
  "manifest_version": 3,
  "name": "محاسب پرو - صدور فاکتور سریع",
  "short_name": "محاسب پرو",
  "description": "پنجره مستقل و جابه‌جاپذیر برای صدور سریع فاکتور بدون مراجعه به داشبورد.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "محاسب پرو - فاکتور سریع"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "windows"],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
