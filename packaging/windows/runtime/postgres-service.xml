<?xml version="1.0" encoding="UTF-8"?>
<!--
  WinSW template for the MohasebProPG service.
  setup-database.ps1 replaces the __TOKENS__ and installs this file
  next to a copy of WinSW named MohasebProPG.exe.
  The service runs as LocalSystem (no <serviceaccount>): WinSW could
  not install ANY named account on a real machine (error 1332,
  ERROR_NONE_MAPPED) even though the same name resolved fine in
  Windows itself. LocalSystem is also the identity PostgreSQL's own
  pg_ctl register uses by default, it needs no account lookup, and
  PostgreSQL accepts it (its admin check tests Administrators-group
  membership, which the SYSTEM token does not have). The server only
  ever listens on 127.0.0.1.
-->
<service>
  <id>MohasebProPG</id>
  <name>Mohaseb Pro Database (PostgreSQL)</name>
  <description>Bundled PostgreSQL server for Mohaseb Pro. Managed by the Mohaseb Pro installer; do not edit manually.</description>
  <executable>%SystemRoot%\System32\cmd.exe</executable>
  <arguments>/c "__APPDIR__\runtime\pg-start.cmd"</arguments>
  <workingdirectory>__DATADIR__</workingdirectory>
  <env name="MOHASEB_HOME" value="__DATADIR__" />
  <env name="MOHASEB_PG_PORT" value="__PGPORT__" />
  <startmode>Automatic</startmode>
  <logpath>__DATADIR__\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>60sec</stoptimeout>
</service>
