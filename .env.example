# نمونهٔ متغیرهای محیطی محاسب پرو — این فایل را کپی و مقادیر واقعی را فقط
# در محیط اجرا تنظیم کنید؛ هرگز کلید واقعی را commit نکنید.
# Mohaseb Pro environment variables — copy the values into your real
# environment / .env file. Never commit a real secret key.

# (الزامی در محیط واقعی) کلید خصوصی تصادفی و ثابت جنگو
# Required in production; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# در محیط واقعی حتماً false باشد / Must be "false" in production
DJANGO_DEBUG=true

# نام میزبان‌های مجاز، جداشده با ویرگول / Comma-separated allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# مبدأهای مجاز فرانت‌اند (CORS)، جداشده با ویرگول
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# سقف حجم آپلود در حافظه (بایت) — مقدار پیش‌فرض در settings.py
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=268435456

# نشانی پایهٔ API برای فرانت‌اند (اختیاری؛ در فرانت هنگام build تنظیم شود)
# VITE_API_URL=http://localhost:8000/api/

# مسیر فایل دیتابیس و فایل‌های آپلودشده (اختیاری؛ در Docker خودکار تنظیم می‌شود)
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media
