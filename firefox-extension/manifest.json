{
  "manifest_version": 2,
  "name": "محاسب پرو - صدور فاکتور سریع",
  "short_name": "محاسب پرو",
  "description": "پنجره مستقل و جابه‌جاپذیر برای صدور سریع فاکتور بدون مراجعه به داشبورد.",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "mohaseb-pro@invoice.local",
      "strict_min_version": "91.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "محاسب پرو - فاکتور سریع"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "storage",
    "windows",
    "http://localhost:8000/*"
  ]
}
